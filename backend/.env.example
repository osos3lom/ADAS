# Copy to .env and adjust for your hardware setup
# docker compose reads this automatically

LOG_LEVEL=info

# ── CAN Bus ───────────────────────────────────────────────────────────────────
# virtual    = python-can VirtualBus (no hardware needed)
# socketcan  = real SocketCAN adapter (vcan0, can0, etc.)
CAN_INTERFACE=virtual
CAN_CHANNEL=vcan0

