# Copy to .env and adjust for your setup. docker compose reads this automatically.

# ── Backend (Phase 0) ─────────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins ("*" allows all).
CORS_ORIGINS=*

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Leave unset to run in-memory only (no persistence). docker-compose sets this.
#   docker:  postgresql+psycopg://adas:adas@db:5432/adas
#   local:   postgresql+psycopg://adas:adas@localhost:5432/adas
#   sqlite:  sqlite:///./adas.db
DATABASE_URL=postgresql+psycopg://adas:adas@db:5432/adas

# ── CARLA server probe (Admin / Control Center status) ────────────────────────
# Host/port the backend TCP-probes to report CARLA online/offline.
#   In docker, host.docker.internal reaches the Windows host running CARLA.
CARLA_HOST=host.docker.internal
CARLA_PORT=2000

# ── CAN bus (Phase 3) ─────────────────────────────────────────────────────────
# CAN_INTERFACE  socketcan | virtual | kvaser | pcan
# CAN_CHANNEL    vcan0, can0, PCAN_USBBUS1, ...
CAN_INTERFACE=virtual
CAN_CHANNEL=vcan0

# ── ROS2 bridge (Phase 3) ─────────────────────────────────────────────────────
# Set true only on an Ubuntu box with ROS2 Humble installed and sourced.
ROS2_ENABLED=false
